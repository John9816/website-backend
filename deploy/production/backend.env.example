# Copy to /opt/website/backend/.env and chmod 600.
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/website?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=website
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-database-password

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-base64-secret
JWT_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=30

# Change these before the first start, then change the admin password after login.
APP_ADMIN_DEFAULT_USERNAME=admin
APP_ADMIN_DEFAULT_PASSWORD=replace-with-a-strong-admin-password

APP_UPDATE_STORAGE_DIR=/opt/website/updates
APP_UPDATE_BASE_URL=https://api.751152.xyz/updates
# Registered accounts receive lifetime access without redeeming a code.
APP_MEMBERSHIP_FREE_LIFETIME_ENABLED=true
WEBSITE_SHARED_DIR=/opt/website/shared
AVATAR_UPLOAD_DIR=/opt/website/shared/uploads/avatars

# NetEase playback resolver. Store the real key only in /opt/website/backend/.env.
CHKSZ_ENABLED=false
CHKSZ_BASE_URL=https://api.chksz.com
CHKSZ_API_KEY=

CLOUD_MAIL_BASE_URL=https://mail.751152.xyz
CLOUD_MAIL_USERNAME=admin@751152.xyz
CLOUD_MAIL_PASSWORD=replace-with-the-cloud-mail-password
CLOUD_MAIL_FROM=admin@751152.xyz
APP_EMAIL_VERIFICATION_REQUIRED=true
