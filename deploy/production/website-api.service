[Unit]
Description=Website Spring Boot API
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/website/current/backend
EnvironmentFile=/opt/website/backend/.env
# Runtime limits for the current 2-core, 1.6 GiB ECS host. Keep enough headroom
# for MariaDB, nginx, the Node frontend, native image work and the page cache.
Environment=TOMCAT_MAX_THREADS=96
Environment=TOMCAT_MIN_SPARE_THREADS=8
Environment=TOMCAT_ACCEPT_COUNT=128
Environment=TOMCAT_MAX_CONNECTIONS=1024
Environment=HIKARI_MAX_POOL_SIZE=10
Environment=HIKARI_MIN_IDLE=2
ExecStart=/usr/bin/java \
  -server \
  -Xms384m \
  -Xmx768m \
  -Xss512k \
  -XX:MetaspaceSize=96m \
  -XX:MaxMetaspaceSize=256m \
  -XX:+UseG1GC \
  -XX:MaxGCPauseMillis=250 \
  -XX:InitiatingHeapOccupancyPercent=40 \
  -XX:+ParallelRefProcEnabled \
  -XX:+UseStringDeduplication \
  -XX:+ExitOnOutOfMemoryError \
  -XX:-OmitStackTraceInFastThrow \
  -Djava.security.egd=file:/dev/./urandom \
  -Dfile.encoding=UTF-8 \
  -Duser.timezone=Asia/Shanghai \
  -Djava.awt.headless=true \
  -jar /opt/website/current/backend/website.jar \
  --server.port=8090
Restart=always
RestartSec=10
SuccessExitStatus=143
TimeoutStopSec=30
LimitNOFILE=65535
# Restart after an OOM exit so systemd can recover the API.
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
